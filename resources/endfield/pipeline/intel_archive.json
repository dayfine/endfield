{
    // The archive list page has its own close button inside CloseButtonType1's ROI, so
    // "close button gone" never holds after closing an item's detail view. The detail
    // view covers the top-left with a dark panel; treat it as closed once the list page's
    // title (情報檔案庫/<tab>) is readable there again.
    "IntelArchiveResolveTruncClosed": {
        "recognition": "And",
        "all_of": ["InIntelArchiveView2"],
        "inverse": false
    },

    // Phone archive cards have a different shape from PC's (the only templates MaaEnd
    // ships for this): at 720p a card is ~167x141 with a 50px tab, vs 122x142 / 37px.
    // image/IntelArchive/ItemIcon2.png is the PC template widened to 167x142. Offsets
    // below are the PC ones scaled by x 1.37, y 1.29 (label 148px below the tab vs 115).
    // The label width stays under one card (~160px), or OCR boxes span two cards and the
    // tap meant to open a truncated title lands in the gap between them.
    "IntelArchiveRecognitionItemTextBackground": {
        "roi_offset": [0, 148, 80, 30]
    },
    "IntelArchiveRecognitionItemNoPageCount": {
        "roi_offset": [58, 121, 5, 10]
    },
    "IntelArchiveRecognitionItemSecretWithoutPageCount": {
        "all_of": [
            "IntelArchiveRecognitionItemIcon",
            "IntelArchiveRecognitionItemLine",
            "IntelArchiveRecognitionItemNoPageCount",
            {
                "count": 30,
                "lower": [212, 212, 212],
                "recognition": "ColorMatch",
                "roi": "IntelArchiveRecognitionItemNoPageCount",
                "roi_offset": [-58, 23, 110, 25],
                "sub_name": "text_bg",
                "upper": [232, 232, 232]
            },
            {
                "connected": true,
                "count": 1500,
                "lower": [40, 40, 40],
                "recognition": "ColorMatch",
                "roi": "text_bg",
                "sub_name": "text_color",
                "upper": [180, 180, 180]
            }
        ]
    },

    // The TC client calls this tab 紙本紀錄, not a character conversion of 纸质记录.
    "IntelArchiveSyncFindingsClickPaperTab": {
        "expected": ["纸质记录", "紙質記錄", "紙本紀錄"]
    },

    // Opening a truncated title sometimes fails when the tap lands while the previous
    // detail view is still closing; wait for the list area to be still first.
    "IntelArchiveResolveTrunc": {
        "pre_wait_freezes": {"target": [280, 100, 960, 560], "time": 300},
        "on_error": ["EndfieldIntelArchiveSkipItem"]
    },

    // If an item still doesn't open, skip it instead of failing the whole scan. That
    // item's title then shows up only as an OCR miss (recovered by fuzzy match, if at all).
    "EndfieldIntelArchiveSkipItem": {
        "desc": "endfield: skip an archive item that didn't open",
        "recognition": "DirectHit",
        "action": "DoNothing"
    },

    // ListCompleteRecognition ends a tab when the screen after a scroll is >= threshold
    // similar to the one before. Paper/electronic lists repeat a few icons, so 0.98 ended
    // the 紙本紀錄 tab after 6 of ~17 screens.
    "IntelArchiveSyncAudioRecordsScrollFinishMedia": {"custom_recognition_param": {"threshold": 0.995}},
    "IntelArchiveSyncFindingsScrollFinishCollection": {"custom_recognition_param": {"threshold": 0.995}},
    "IntelArchiveSyncFindingsScrollFinishElectronic": {"custom_recognition_param": {"threshold": 0.995}},
    "IntelArchiveSyncFindingsScrollFinishPaper": {"custom_recognition_param": {"threshold": 0.995}},
    "IntelArchiveSyncIntelGatheringInnerScrollFinish": {"custom_recognition_param": {"threshold": 0.995}},
    "IntelArchiveSyncIntelGatheringScrollFinish": {"custom_recognition_param": {"threshold": 0.995}},
    "IntelArchiveSyncNexusFilesScrollFinishCentral": {"custom_recognition_param": {"threshold": 0.995}},
    "IntelArchiveSyncNexusFilesScrollFinishReport": {"custom_recognition_param": {"threshold": 0.995}},

    // Detail view: the white strip above the title is at (322, 61, 119x7) on the phone,
    // just below PC's ROI (y 0-60), so no page title was read. That left multi-page
    // entries (read page by page here) and truncated titles unrecorded. Stop the ROI above
    // the title text (y 76+) so the strip is the connected white blob it finds.
    "IntelArchiveRecognitionDetailFlag": {
        "roi": [300, 40, 260, 34]
    },
    "IntelArchiveRecognitionDetailTitleColor": {
        "roi_offset": [-22, 10, 600, 42]
    }
}
